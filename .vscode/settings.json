{
  // --- LaTeX Workshop: build whichever file is open ---------------------------
  // Build (Ctrl+Alt+B) whichever root file is open, with no prompt:
  //   latex/main.tex            the whole document
  //   latex/sections/<sec>.tex  just that section (standalone subfile build)
  //   latex/notes/<note>.tex    that note (self-contained article)
  "latex-workshop.latex.rootFile.doNotPrompt": true,
  "latex-workshop.latex.rootFile.useSubFile": true,

  // --- Keep intermediate files out of the source tree -------------------------
  // Everything a build produces (.aux, .bcf, .log, .pdf, ...) goes into a build/
  // beside the root file: latex/build/, latex/sections/build/ or
  // latex/notes/build/. Matches the Makefile and the .latexmkrc files.
  "latex-workshop.latex.outDir": "%DIR%/build",

  // Optionally also delete the intermediates after every build.
  // Off by default because it forces a full rebuild (including biber) each time.
  // "latex-workshop.latex.autoClean.run": "onBuilt",

  // --- Hide build artefacts in the explorer and search -------------------------
  // build/ is hidden outright; the per-extension patterns also cover anything
  // produced by an in-place command-line build.
  "files.exclude": {
    "**/build": true,
    "**/*.aux": true,
    "**/*.bbl": true,
    "**/*.bcf": true,
    "**/*.blg": true,
    "**/*.fdb_latexmk": true,
    "**/*.fls": true,
    "**/*.lof": true,
    "**/*.log": true,
    "**/*.lot": true,
    "**/*.nav": true,
    "**/*.out": true,
    "**/*.run.xml": true,
    "**/*.snm": true,
    "**/*.synctex.gz": true,
    "**/*.synctex(busy)": true,
    "**/*.synctex.gz(busy)": true,
    "**/*.toc": true,
    "**/*.vrb": true,
    "**/*.xdv": true
  },
  "search.exclude": {
    "**/build": true,
    "**/*.pdf": true,
    "**/*.aux": true,
    "**/*.bbl": true,
    "**/*.bcf": true,
    "**/*.log": true,
    "**/*.run.xml": true
  },
  "files.watcherExclude": {
    "**/build/**": true
  }
}
