# Build output directory (latexmk, Makefile and VS Code all write here)
build/

# LaTeX build artefacts from any in-place build
*.aux
*.bbl
*.bcf
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.run.xml
*.synctex.gz
*.toc
*.lof
*.lot
*.nav
*.snm
*.vrb
*.xdv
*.pdf
# biber leaves main.bbl-SAVE-ERROR / main.bcf-SAVE-ERROR after a failed run
*-SAVE-ERROR

# Python / fct library
cache/
.cache/
.venv/
.uv-cache/
__pycache__/
*.pt
.claude/worktrees/
.pytest_cache/
.pm/

# Local scratch directory
tmp/

# Pinned regression fixtures are small and must be tracked
!tests/fixtures/*.pt
